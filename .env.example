# Keep 127.0.0.1 for host-only access and Android Emulator via 10.0.2.2.
# Use 0.0.0.0 only for trusted LAN devices. Public deployments need TLS.
CUE_BIND_ADDRESS=127.0.0.1
CUE_WEB_PORT=8080
# HTTPS is enabled with: docker compose --profile https up --build -d
# Point these paths to a certificate and key for your HTTPS domain.
CUE_HTTPS_BIND_ADDRESS=0.0.0.0
CUE_HTTPS_PORT=443
CUE_TLS_CERT_FILE=./certs/fullchain.pem
CUE_TLS_KEY_FILE=./certs/privkey.pem
CUE_TIMEZONE=Asia/Shanghai

POSTGRES_DB=cue
POSTGRES_USER=cue
POSTGRES_PASSWORD=replace-with-a-long-database-password

# Admin account: Created interactively on first launch via the Web UI.
# Credentials are never stored in this file and are securely hashed in PostgreSQL.
# In case the password is forgotten, run:
# docker compose exec cue-api npm run reset-password -- <new-password>

# Use two independent random values with at least 32 characters each.
CUE_JWT_SECRET=replace-with-at-least-32-random-characters
CUE_REFRESH_SECRET=replace-with-another-32-random-characters
