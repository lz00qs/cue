# Web is bound to localhost by default. Change the Compose port mapping before
# exposing Cue through a reverse proxy with TLS.
CUE_WEB_PORT=8080
CUE_TIMEZONE=Asia/Shanghai

POSTGRES_DB=cue
POSTGRES_USER=cue
POSTGRES_PASSWORD=replace-with-a-long-database-password

CUE_ADMIN_EMAIL=admin@cue.local
# Use either CUE_ADMIN_PASSWORD or a bcrypt CUE_ADMIN_PASSWORD_HASH.
CUE_ADMIN_PASSWORD=replace-with-a-long-login-password
CUE_ADMIN_PASSWORD_HASH=

# Use two independent random values with at least 32 characters each.
CUE_JWT_SECRET=replace-with-at-least-32-random-characters
CUE_REFRESH_SECRET=replace-with-another-32-random-characters
